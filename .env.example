# Well Said — local environment
#
# Copy this file to .env.local (git-ignored) and fill in your values:
#   cp .env.example .env.local
#
# These variables are read ONLY by the Node audio pipeline in scripts/audio/.
# They are never bundled into the web app. Do not rename them with a VITE_
# prefix: Vite exposes VITE_* variables to the browser.

# Required for `npm run audio:plan` (credits), `audio:generate`, and `audio:voices`.
# Create one at https://elevenlabs.io/app/settings/api-keys
# Minimum permissions: Text to Speech, Voices (read), User (read).
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional. Speech model for dialogue lines and expressions.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional. Model for the opt-in Stress Mode recordings (`--with-stress`).
# ELEVENLABS_STRESS_MODEL_ID=eleven_v3

# Optional. Comma-separated voice IDs for each voice pool. Each speaker gets a
# stable voice from the pool that fits the character. Run `npm run audio:voices`
# to list the voices your key can use. Defaults are ElevenLabs premade voices.
# ELEVENLABS_VOICES_FEMALE=EXAVITQu4vr4xnSDxMaL,cgSgspJ2msm6clMCkdW9,XrExE9yKIg1WjnnlVkGX,hpp4J3VqNfWAUOO0d1Us,Xb7hH8MSUJpSbSDYk0k2
# ELEVENLABS_VOICES_MALE=iP95p4xoKVk53GoZ742B,cjVigY5qzO86Huf0OWal,bIHbv24MWmeRgasZH58o,CwhRBWXzGAHq8TQ4Fs17,JBFqnCBsd6RMkjVDRZzb

# Optional. Native delivery speed (0.7–1.2, default 1). Changing it re-synthesizes
# every file and spends credits. Rushed clips are already eased to ~200 wpm locally.
# ELEVENLABS_SPEED=1

# Optional. Parallel requests to ElevenLabs (keep within your plan's concurrency limit).
# ELEVENLABS_CONCURRENCY=2
